# === Lokale Entwicklung (Vite) =============================================
# Im Dev-Modus gehen API-Aufrufe standardmäßig über dieselbe Origin (/api/v1).
# Vite leitet an VITE_PROXY_TARGET weiter; bei Verbindungsfehler optional an Fallback.

# Primäres Backend (Docker: http://backend:8000)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Fallback wenn primär nicht erreichbar (abschalten: VITE_PROXY_FALLBACK=off).
# Hinweis: Requests mit Bearer-Token nutzen keinen Fallback (JWT gilt nur fürs lokale Backend).
VITE_PROXY_FALLBACK=https://test.finalstage.ch

# Nur nötig, wenn du die API wirklich direkt vom Browser ansprechen willst:
# VITE_DEV_DIRECT_API=true
# Optional: Plattform-App-ID für POST /platform/feedback (wenn Dashboard-Apps nicht nutzbar)
# VITE_FEEDBACK_APP_ID=1

